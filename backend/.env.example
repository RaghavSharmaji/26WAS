# Local MongoDB (install and start MongoDB Community Server first)
MONGODB_URI=mongodb://127.0.0.1:27017/wms_f

# Generate your own private secret; never commit backend/.env
SECRET_OR_KEY=replace_with_a_long_random_secret

# Super Admin credentials provision one hashed account on first backend startup.
# Changing SUPER_ADMIN_PASSWORD does not overwrite an existing account; use
# `npm run superadmin:reset-password` for an explicit credential update.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@wareflow.com
SUPER_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD

# Optional; defaults to 5000
PORT=5000

# Optional; comma-separated frontend origins. Local Vite origins are allowed by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional; only needed for npm run seed:admin
WMS_ADMIN_NAME=Warehouse Admin
WMS_ADMIN_EMAIL=replace_with_your_admin_email
WMS_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters

# Set this before running `npm run ownership:migrate` to assign unowned legacy
# records to a known existing user. Leave blank until you have chosen the owner.
LEGACY_DATA_OWNER_EMAIL=

# For MongoDB Atlas, replace the local URI with your Atlas connection string.
# Keep the username/password private and URL-encode special characters.
